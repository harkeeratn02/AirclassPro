# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Base URL for API calls if frontend and backend are hosted on different domains
VITE_API_URL=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# BILLING: Google Play Store / Google Pay Configuration
VITE_GOOGLE_PAY_MERCHANT_ID=
VITE_GOOGLE_PLAY_STORE_ID=
